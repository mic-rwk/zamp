	-rm -f ./$(DEPDIR)/interp-Set4LibInterfaces.Po
	-rm -f ./$(DEPDIR)/interp-main.Po
	-rm -f ./$(DEPDIR)/interp-preprocessor.Po
	-rm -f ./$(DEPDIR)/interp-xmlinterp.Po
	-rm -f Makefile
