	-rm -f ./$(DEPDIR)/interp-ComChannel.Po
	-rm -f ./$(DEPDIR)/interp-CommandsParser.Po
	-rm -f ./$(DEPDIR)/interp-Configuration.Po
	-rm -f ./$(DEPDIR)/interp-LibInterface.Po
